# ---- Multiplayer server (server/server.js) ----
# Port the WebSocket/HTTP server listens on
PORT=8787
# Comma-separated list of allowed browser origins, or * for any (use your site URL in production)
CLIENT_ORIGIN=*
NODE_ENV=development
# Online match length in seconds and AI difficulty for the AI teammates/opponents
MATCH_DURATION=300
AI_DIFFICULTY=NORMAL
# LOG_LEVEL=silent hides info logs

# ---- Client (Vite; must start with VITE_) ----
# Where the browser connects for multiplayer. Defaults to ws://<current host>:8787 when unset.
# Production example: VITE_GAME_SERVER_URL=wss://play.example.com
VITE_GAME_SERVER_URL=ws://localhost:8787
